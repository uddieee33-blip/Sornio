# --- Where these go, and how to check them ----------------------------------
# Copy this file to .env.local and fill in the values below. Each variable is
# also listed, with its real state for your deployment, in the console:
#
#     Settings -> Environment setup     (reads GET /api/health)
#
# That page shows which of these are set, which are malformed, and exactly what
# stops working without each one — it never shows a secret's value.
#
#   cp .env.example .env.local
#   openssl rand -hex 32        # run twice: session secret, activation secret

# --- Supabase (optional) -----------------------------------------------------
# With placeholders the console stays fully local-first: every record lives on
# the owner's device, encrypted at rest. With real credentials it syncs.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Deployment --------------------------------------------------------------
# The origin this deployment is served from. A real, non-local domain switches
# the security posture to "strict" (HSTS, frame-ancestors 'self').
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign session tokens and the plan cookie. 32+ characters.
# Without it a per-host development fallback is used — set it in production.
#   openssl rand -hex 32
DUKAANOS_SESSION_SECRET=

# --- Selling DukaanOS --------------------------------------------------------
# Secret that signs *activation codes* — the bridge from "the owner paid" to
# "the plan is on". Server-only: it must never reach the browser, or an owner
# could mint their own plan. With it unset, activation is disabled and the API
# says so (it never falls back to something guessable).
#   openssl rand -hex 32
#   npm run mint:activation -- --plan growth --months 3 --reference UPI-XXXX
DUKAANOS_ACTIVATION_SECRET=

# Where owners pay the platform. DukaanOS collects its own plan price on its own
# UPI — no gateway, no auto-debit, no card on file — so this is the payee shown
# on Your Plan, plus the WhatsApp number that answers "I have paid".
NEXT_PUBLIC_PLANS_UPI_ID=
NEXT_PUBLIC_PLANS_PAYEE_NAME=DukaanOS
NEXT_PUBLIC_SUPPORT_WHATSAPP=
