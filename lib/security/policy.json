{
  "version": "2026.10.0",
  "csp": {
    "default-src": [
      "'self'"
    ],
    "script-src": [
      "'self'"
    ],
    "style-src": [
      "'self'",
      "'unsafe-inline'"
    ],
    "img-src": [
      "'self'",
      "data:",
      "blob:"
    ],
    "font-src": [
      "'self'",
      "data:"
    ],
    "connect-src": [
      "'self'",
      "https://*.supabase.co",
      "wss://*.supabase.co"
    ],
    "media-src": [
      "'none'"
    ],
    "worker-src": [
      "'self'",
      "blob:"
    ],
    "manifest-src": [
      "'self'"
    ],
    "frame-src": [
      "'none'"
    ],
    "base-uri": [
      "'none'"
    ],
    "form-action": [
      "'self'"
    ],
    "object-src": [
      "'none'"
    ],
    "child-src": [
      "'none'"
    ],
    "script-src-attr": [
      "'none'"
    ],
    "require-trusted-types-for": [
      "'script'"
    ],
    "trusted-types": [
      "default",
      "nextjs#bundler",
      "'allow-duplicates'"
    ]
  },
  "framing": {
    "strict": [
      "'self'"
    ],
    "embed": [
      "'self'",
      "https://*.e2b.app",
      "https://e2b.app",
      "https://*.arena.ai",
      "https://arena.ai",
      "http://localhost",
      "http://localhost:*",
      "http://127.0.0.1",
      "http://127.0.0.1:*"
    ]
  },
  "headers": [
    {
      "key": "X-Content-Type-Options",
      "value": "nosniff"
    },
    {
      "key": "Referrer-Policy",
      "value": "strict-origin-when-cross-origin"
    },
    {
      "key": "Cross-Origin-Opener-Policy",
      "value": "same-origin"
    },
    {
      "key": "Cross-Origin-Resource-Policy",
      "value": "same-origin"
    },
    {
      "key": "Origin-Agent-Cluster",
      "value": "?1"
    },
    {
      "key": "X-DNS-Prefetch-Control",
      "value": "off"
    },
    {
      "key": "X-Permitted-Cross-Domain-Policies",
      "value": "none"
    },
    {
      "key": "X-Download-Options",
      "value": "noopen"
    },
    {
      "key": "Cross-Origin-Embedder-Policy",
      "value": "unsafe-none"
    },
    {
      "key": "X-Robots-Tag",
      "value": "noindex, nofollow, noarchive, nosnippet"
    }
  ],
  "hsts": {
    "key": "Strict-Transport-Security",
    "value": "max-age=63072000; includeSubDomains; preload"
  },
  "noStore": {
    "key": "Cache-Control",
    "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
  },
  "rateLimits": {
    "api": {
      "limit": 90,
      "windowMs": 60000
    },
    "apiRead": {
      "limit": 240,
      "windowMs": 60000
    },
    "prefetch": {
      "limit": 900,
      "windowMs": 60000
    },
    "auth": {
      "limit": 12,
      "windowMs": 60000
    },
    "reports": {
      "limit": 20,
      "windowMs": 60000
    },
 "portal": {
  "limit": 8,
  "windowMs": 60000
 },
 "team": {
  "limit": 20,
  "windowMs": 60000
 },
    "plan": {
      "limit": 12,
      "windowMs": 60000
    },
    "page": {
      "limit": 600,
      "windowMs": 60000
    },
    "burstApi": {
      "limit": 8,
      "windowMs": 5000
    },
    "burstApiRead": {
      "limit": 60,
      "windowMs": 5000
    },
    "burstPrefetch": {
      "limit": 300,
      "windowMs": 5000
    },
    "burstPage": {
      "limit": 150,
      "windowMs": 5000
    },
    "master": {
      "limit": 6,
      "windowMs": 60000
    },
    "profile": {
      "limit": 20,
      "windowMs": 60000
    },
    "report": {
      "limit": 20,
      "windowMs": 60000
    }
  },
  "probePaths": [
    "/.DS_Store",
    "/.aws",
    "/.dockerenv",
    "/.env",
    "/.env.development",
    "/.env.local",
    "/.env.production",
    "/.git",
    "/.git/config",
    "/.hg",
    "/.npmrc",
