    "/.svn",
    "/.vscode/sftp.json",
    "/.well-known/openid-configuration/.env",
    "/_ignition/execute-solution",
    "/actuator",
    "/admin.php",
    "/api/.env",
    "/aws.yml",
    "/backup.sql",
    "/cgi-bin",
    "/config.json",
    "/credentials",
    "/db.sqlite",
    "/debug/default/view",
    "/docker-compose.yml",
    "/dump.sql",
    "/id_rsa",
    "/jenkins",
    "/laravel/.env",
    "/package-lock.json.bak",
    "/phpmyadmin",
    "/secrets",
    "/server-status",
    "/solr",
    "/telescope/requests",
    "/vendor/phpunit",
    "/wp-admin",
    "/wp-content",
    "/wp-includes",
    "/wp-login.php",
    "/xmlrpc.php"
  ],
  "permissions": {
    "features": {
      "accelerometer": [],
      "autoplay": [],
      "camera": [],
      "clipboard-read": [],
      "display-capture": [],
      "encrypted-media": [],
      "fullscreen": [
        "self"
      ],
      "geolocation": [],
      "gyroscope": [],
      "hid": [],
      "idle-detection": [],
      "magnetometer": [],
      "microphone": [],
      "midi": [],
      "payment": [],
      "picture-in-picture": [],
      "publickey-credentials-create": [],
      "publickey-credentials-get": [
        "self"
      ],
      "screen-wake-lock": [],
      "serial": [],
      "usb": [],
      "xr-spatial-tracking": []
    },
    "capture": [
      {
        "label": "Camera barcode scanning",
        "surfaces": [
          "/scan",
          "/sales",
          "/products"
        ],
        "grants": {
          "camera": [
            "self"
          ]
        }
      },
      {
        "label": "Fingerprint check-in (WebAuthn)",
        "surfaces": [
          "/check-ins"
        ],
        "grants": {
          "publickey-credentials-create": [
            "self"
          ],
          "publickey-credentials-get": [
            "self"
          ]
        }
      },
      {
        "label": "Passkey enrolment (Trust Centre)",
        "surfaces": [
          "/security"
        ],
        "grants": {
          "publickey-credentials-create": [
            "self"
          ]
        }
      }
    ]
  },
  "reporting": {
    "endpoint": "/api/report",
    "group": "dukaan",
    "maxAgeSeconds": 86400,
    "note": "Violation reports are redacted, bounded and never leave this origin. The endpoint stores nothing by default: it counts, classifies and drops. A report is a signal that the policy or the app is wrong, not a place to collect telemetry about an owner's browser."
  },
  "abuse": {
    "strikesBeforePenalty": 4,
    "penaltyMs": 120000,
    "maxPenaltyMs": 1800000,
    "strikeWindowMs": 300000,
    "note": "A client that keeps hitting 429 is not a shop that got busy; it is a script. After four throttles inside five minutes the fingerprint is put in a penalty box that doubles each time, capped at thirty minutes. Only a write or a credential attempt can earn a strike: reads are the console talking to itself, and budgeting them like attacks meant an owner who clicked around quickly collected throttles and then a lockout. Writes, credential attempts and the money endpoints keep the tight buckets; reads get a ceiling a person cannot reach but a script still can. Speculative route prefetches get their own budget for the same reason, from the other direction: the console warms its own sidebar on idle, so charging prefetch traffic to the navigation budget meant the app throttled the owner for loading its own screens. The ceilings themselves are set from what the app spends on the owner's behalf: one console page view costs about thirteen page-bucket requests and forty prefetches, so the navigation ceiling sits at roughly forty page views a minute — past any person clicking, and still a bound on a script."
  }
}
