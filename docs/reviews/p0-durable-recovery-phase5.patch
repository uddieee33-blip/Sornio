+            operation_id: Some(operation_id),
+            state: Some(state),
+            backup_id: Some(backup_id),
+            requires_resolution: true,
+        },
+        None => RecoveryStatus {
+            fenced: fence_active(db)?,
+            operation_id: None,
+            state: None,
+            backup_id: None,
+            requires_resolution: false,
+        },
+    })
